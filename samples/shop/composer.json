{
    "name": "specrig/sample-shop",
    "description": "A Laravel web API over Postgres that calls billing, queues work and publishes over RabbitMQ",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "specrig/specrig": "0.1.0",
                    "specrig/laravel": "0.1.0",
                    "specrig/symfony": "0.1.0"
                }
            }
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "php-amqplib/php-amqplib": "^3.7"
    },
    "require-dev": {
        "behat/behat": "^3.34",
        "phpunit/phpunit": "^11.5",
        "specrig/laravel": "0.1.0",
        "webmozart/assert": "^2.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Tests\\Internal\\": "tests/internal/",
            "Tests\\Steps\\": "tests/steps/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
