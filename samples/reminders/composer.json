{
    "name": "specrig/sample-reminders",
    "description": "A Symfony worker over Postgres and Redis that reminds billing's customers, scheduled, by hand and over RabbitMQ",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "specrig/specrig": "0.1.0",
                    "specrig/laravel": "0.1.0",
                    "specrig/symfony": "0.1.0"
                }
            }
        }
    ],
    "require": {
        "php": "^8.4",
        "doctrine/doctrine-bundle": "^2.13 || ^3.0",
        "doctrine/doctrine-migrations-bundle": "^3.4 || ^4.0",
        "doctrine/orm": "^3.3",
        "php-amqplib/php-amqplib": "^3.7",
        "predis/predis": "^3.0",
        "symfony/console": "^8.0",
        "symfony/doctrine-messenger": "^8.0",
        "symfony/dotenv": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/http-client": "^8.0",
        "symfony/messenger": "^8.0",
        "symfony/runtime": "^8.0",
        "symfony/scheduler": "^8.0",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "behat/behat": "^4.0",
        "phpunit/phpunit": "^12.0",
        "specrig/symfony": "0.1.0",
        "webmozart/assert": "^2.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
